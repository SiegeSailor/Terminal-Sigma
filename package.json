{
	"author": {
		"name": "SiegeSailor",
		"email": "siegesailor@gmail.com",
		"url": "https://jinyu-zhang.com/"
	},
	"name": "@siegesailor/terminal-sigma",
	"keywords": [
		"command-line-tool",
		"typescript",
		"pastel"
	],
	"description": "A CLI comes with self-development and assistance features. While serving as a personal assistant, it provides gaming feedback to keep users stick to this terminal session.",
	"homepage": "https://github.com/SiegeSailor/Terminal-Sigma",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SiegeSailor/Terminal-Sigma.git"
	},
	"bugs": {
		"url": "https://github.com/SiegeSailor/Terminal-Sigma/issues"
	},
	"version": "0.0.0",
	"bin": {
		"siegesailor-terminal-sigma": "build/command-line-interface.js"
	},
	"main": "build/command-line-interface.js",
	"files": [
		"build/",
		"!build/tests/"
	],
	"license": "MIT",
	"private": false,
	"type": "module",
	"engines": {
		"node": ">= 22"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"prepare": "husky",
		"build": "node --input-type=module --eval \"import {rmSync} from 'node:fs'; rmSync('build', {recursive: true, force: true}); rmSync('build-cache', {force: true});\" && tsc && tsc-alias && node --input-type=module --eval \"import {chmodSync} from 'node:fs'; chmodSync('build/command-line-interface.js', 0o755);\"",
		"prepack": "npm run build",
		"test": "prettier --check --ignore-unknown . && xo && ava",
		"start": "npm run build && npm link --local && siegesailor-terminal-sigma"
	},
	"dependencies": {
		"@inkjs/ui": "2.0.0",
		"ink": "7.0.0",
		"meow": "14.1.0",
		"pastel": "4.0.1",
		"react": "19.2.5",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@ava/typescript": "6.0.0",
		"@commitlint/cli": "20.5.0",
		"@commitlint/config-conventional": "20.5.0",
		"@semantic-release/git": "11.0.1",
		"@types/react": "19.2.14",
		"ava": "7.0.0",
		"conventional-changelog-conventionalcommits": "10.4.0",
		"husky": "9.1.7",
		"ink-testing-library": "4.0.0",
		"lint-staged": "16.4.0",
		"prettier": "3.8.2",
		"semantic-release": "25.0.9",
		"ts-node": "10.9.2",
		"tsc-alias": "1.8.16",
		"typescript": "6.0.2",
		"xo": "2.0.2"
	},
	"lint-staged": {
		"*": [
			"prettier --write --ignore-unknown"
		]
	}
}

{
	"name": "terminal-sigma-desktop",
	"productName": "Terminal Sigma",
	"version": "0.0.0",
	"description": "Terminal Sigma as a desktop app: the dashboard in its own window.",
	"author": {
		"name": "SiegeSailor",
		"email": "siegesailor@gmail.com"
	},
	"homepage": "https://github.com/SiegeSailor/Terminal-Sigma",
	"license": "MIT",
	"private": true,
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"bundle": "tsc -p . && node build.mjs",
		"dist": "npm run bundle && electron-builder --publish never",
		"start": "npm run bundle && install-electron && electron ."
	},
	"devDependencies": {
		"@xterm/addon-fit": "0.11.0",
		"@xterm/addon-unicode11": "0.9.0",
		"@xterm/addon-webgl": "0.19.0",
		"@xterm/xterm": "6.0.0",
		"electron": "44.5.1",
		"electron-builder": "26.15.3",
		"esbuild": "0.28.2",
		"typescript": "6.0.2"
	},
	"build": {
		"appId": "com.siegesailor.terminal-sigma",
		"productName": "Terminal Sigma",
		"artifactName": "Terminal-Sigma-${version}-${os}-${arch}.${ext}",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**",
			"index.html"
		],
		"mac": {
			"target": [
				{
					"target": "dmg",
					"arch": [
						"arm64",
						"x64"
					]
				}
			],
			"category": "public.app-category.productivity",
			"identity": "-",
			"hardenedRuntime": false
		},
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			]
		},
		"linux": {
			"target": [
				{
					"target": "AppImage",
					"arch": [
						"x64"
					]
				}
			],
			"category": "Utility"
		}
	}
}
